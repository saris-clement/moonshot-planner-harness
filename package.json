{
  "name": "ainative-planner-eval-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "cli": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts serve",
    "start": "node dist/src/cli.js serve",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "fflate": "^0.8.3",
    "yaml": "^2.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
