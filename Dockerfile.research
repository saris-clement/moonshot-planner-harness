FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd
RUN apk add --no-cache curl jq ripgrep git python3 ca-certificates \
    && mkdir -p /broker /scratch /policy \
    && chmod 1777 /broker /scratch
COPY src/researchSandboxBroker.ts /opt/research/researchSandboxBroker.ts
COPY --chmod=755 scripts/research-curl.mjs /usr/local/bin/curl
ENV HOME=/scratch PATH=/usr/local/bin:/usr/bin:/bin
USER 65534:65534
WORKDIR /scratch
CMD ["/bin/sh"]
